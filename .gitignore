# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# WASM / trunk bundler output
dist/
dist-*/
*.wasm
# trunk may emit these next to sources during some workflows
crates/**/dist/

# OS / editor noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Nucleus: track the tree; never commit secrets
.nucleus/attest.key
.nucleus/**/*.key
.nucleus/**/*.pem
.nucleus/secrets/
# Agent turn dumps — often contain host/ops paths
.nucleus/out/
# Machine-specific Nucleus review metadata
.nucleus/review-bundle.md
.nucleus/review-session.json
.nucleus/attestations/
# Runtime pid/log (parity with RustERP core)
.local/
.nucleus/
.out/
